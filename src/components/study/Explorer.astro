---
// "Explore the data": move the start year and every number recalculates in
// the browser from the same series as the study. Rendered at build time with
// the study's own settings, so it reads correctly before (or without) scripts.
import { DESKTOP, MOBILE, lineSvg } from '../../lib/chart';
import { explore } from '../../lib/explore';
import type { Study } from '../../lib/studies';

interface Props {
  study: Study;
}
const { study } = Astro.props;
const ex = study.data.explorer!;
const c = study.data.chart;
const cfg = { ...ex, aShort: c.aShort, bShort: c.bShort, aLabel: c.aLabel, bLabel: c.bLabel };
const r = explore(cfg, ex.studyStart);
const end = ex.years[ex.years.length - 1];
const EXD = { ...DESKTOP, h: 300, x0: 60, x1: 1080, yTop: 40, yBase: 260, yearY: 282, tickX: 50 };
---

<section class="explorer" aria-labelledby="explorer-title" data-explorer={JSON.stringify(cfg)} data-end={end}>
  <div class="head">
    <div class="titles">
      <p class="kicker">EXPLORE THE DATA</p>
      <h2 id="explorer-title">{ex.question}</h2>
      <p class="muted">Move the start year. Everything below recalculates in your browser from the same data as the study.</p>
    </div>
    {study.data.placeholder && <span class="sample">SAMPLE DATA</span>}
  </div>

  <div class="controls">
    <label for="startYear">START YEAR</label>
    <input
      id="startYear"
      type="range"
      min={ex.years[0]}
      max={ex.years[ex.years.length - 3]}
      step="1"
      value={ex.studyStart}
    />
    <output for="startYear" class="year">{ex.studyStart}</output>
    <div role="group" aria-label="Quick picks" class="chips">
      {
        ex.picks.map((y) => (
          <button type="button" data-year={y} aria-pressed={y === ex.studyStart ? 'true' : 'false'}>
            {y === ex.studyStart ? `${y} · study` : y}
          </button>
        ))
      }
    </div>
  </div>

  <div class="changed" role="status" hidden>
    <p>
      <span class="lbl">YOU'VE CHANGED THE WINDOW ›</span> You're viewing <strong data-f="range"></strong>. The written
      findings use <strong>{ex.studyStart}–{end}</strong>. Over this range the gap is <strong class="acc" data-f="gap"></strong>.
    </p>
    <button type="button" class="reset">Reset to study settings</button>
  </div>

  <div class="tiles">
    <div class="tile lead">
      <span class="k">{ex.gapLabel.toUpperCase()}</span>
      <span class="v" data-f="gap">{r.gapLabel}</span>
      <span class="s">percentage points since <span data-f="start">{ex.studyStart}</span></span>
    </div>
    <div class="tile">
      <span class="k">{c.aShort.toUpperCase()} GROWTH</span>
      <span class="v sm" data-f="a">{r.aLabel}</span>
      <span class="s">{c.aLabel.toLowerCase()}, <span data-f="start">{ex.studyStart}</span> → {end}</span>
    </div>
    <div class="tile">
      <span class="k">{c.bShort.toUpperCase()} GROWTH</span>
      <span class="v sm" data-f="b">{r.bLabel}</span>
      <span class="s">{c.bLabel.toLowerCase()}, <span data-f="start">{ex.studyStart}</span> → {end}</span>
    </div>
    <div class="tile">
      <span class="k">DOES IT HOLD?</span>
      <span class="v txt" data-f="verdict">{r.verdict}</span>
      <span class="s">same sign as the study result</span>
    </div>
  </div>

  <figure>
    <svg class="plot-d" role="img" aria-label={r.label} viewBox="0 0 1100 300" set:html={lineSvg(EXD, r.chart, r.view, null)} />
    <svg class="plot-m" role="img" aria-label={r.label} viewBox={`0 0 ${MOBILE.w} ${MOBILE.h}`} set:html={lineSvg(MOBILE, r.chart, r.view, null)} />
    <figcaption class="foot">
      <span class="legend">
        <span><span class="key-a">━━</span> {c.aLabel} (index, <span data-f="start">{ex.studyStart}</span> = 100)</span>
        <span><span class="key-b">╌╌</span> {c.bLabel} (index, <span data-f="start">{ex.studyStart}</span> = 100)</span>
      </span>
      <span class="mono-note">Axis starts at <span data-f="ymin">{r.view.yMin}</span>, not zero. Share this view: <a data-f="share" href={`?start=${ex.studyStart}`}>?start={ex.studyStart}</a></span>
    </figcaption>
  </figure>

  <div class="more">
    <span class="muted">Want to change more than the start year?</span>
    <span class="mono-note">The full notebook and an offline explorer arrive with the real data.</span>
  </div>
</section>

<script>
  import { DESKTOP, MOBILE, lineSvg } from '../../lib/chart';
  import { explore, type ExploreConfig } from '../../lib/explore';

  const EXD = { ...DESKTOP, h: 300, x0: 60, x1: 1080, yTop: 40, yBase: 260, yearY: 282, tickX: 50 };

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.explorer || '{}') as ExploreConfig;
    const end = root.dataset.end;
    const input = root.querySelector<HTMLInputElement>('input[type=range]')!;
    const out = root.querySelector<HTMLOutputElement>('output')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chips button')];
    const changed = root.querySelector<HTMLElement>('.changed')!;
    const svgD = root.querySelector<SVGSVGElement>('.plot-d')!;
    const svgM = root.querySelector<SVGSVGElement>('.plot-m')!;
    const all = (f: string) => root.querySelectorAll<HTMLElement>(`[data-f="${f}"]`);
    const set = (f: string, t: string) => all(f).forEach((el) => (el.textContent = t));
    const max = Number(input.max), min = Number(input.min);

    const update = (start: number, push = true) => {
      const r = explore(cfg, start);
      input.value = String(start);
      out.textContent = String(start);
      chips.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.year) === start)));
      set('gap', r.gapLabel);
      set('a', r.aLabel);
      set('b', r.bLabel);
      set('verdict', r.verdict);
      set('start', String(start));
      set('range', `${start}–${end}`);
      set('ymin', String(r.view.yMin));
      svgD.innerHTML = lineSvg(EXD, r.chart, r.view, null);
      svgM.innerHTML = lineSvg(MOBILE, r.chart, r.view, null);
      svgD.setAttribute('aria-label', r.label);
      svgM.setAttribute('aria-label', r.label);
      changed.hidden = start === cfg.studyStart;
      const share = all('share')[0] as HTMLAnchorElement | undefined;
      if (share) {
        share.href = `?start=${start}`;
        share.textContent = `?start=${start}`;
      }
      if (push) {
        const u = new URL(location.href);
        if (start === cfg.studyStart) u.searchParams.delete('start');
        else u.searchParams.set('start', String(start));
        history.replaceState(null, '', u);
      }
    };

    input.addEventListener('input', () => update(Number(input.value)));
    chips.forEach((b) => b.addEventListener('click', () => update(Number(b.dataset.year))));
    root.querySelector('.reset')?.addEventListener('click', () => update(cfg.studyStart));

    const fromUrl = Number(new URL(location.href).searchParams.get('start'));
    if (fromUrl >= min && fromUrl <= max && fromUrl !== cfg.studyStart) update(fromUrl, false);
  });
</script>

<style>
  .explorer {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 24px;
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  h2 {
    font-size: 26px;
    letter-spacing: 0;
  }
  .titles .muted {
    font-size: 15px;
  }
  .sample {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--warn);
    border: 1px solid rgb(255 176 138 / 0.4);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 20px;
    background: var(--bg);
  }
  label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }
  input[type='range'] {
    flex: 1 1 260px;
    min-width: 0;
    height: 28px;
    accent-color: var(--accent);
  }
  .year {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    min-width: 64px;
    color: var(--accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips button {
    min-height: 36px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-control);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
  }
  .chips button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .changed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--warn);
    background: var(--warn-bg);
    border-radius: 12px;
    padding: 14px 18px;
  }
  .changed[hidden] {
    display: none;
  }
  .changed p {
    font-size: 15px;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--warn);
  }
  .acc {
    color: var(--accent);
  }
  .reset {
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--text);
    background: transparent;
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .tile {
    flex: 1 1 200px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tile.lead {
    border-color: var(--accent);
  }
  .k {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .lead .k,
  .lead .v {
    color: var(--accent);
  }
  .v {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  .v.sm {
    font-size: 30px;
    line-height: 1.3;
  }
  .v.txt {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.4;
  }
  .s {
    font-size: 13px;
    color: var(--text-2);
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  figure svg {
    width: 100%;
    height: auto;
    display: block;
  }
  figure .plot-m {
    display: none;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 14px;
    color: var(--text-2);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .key-a {
    color: var(--accent);
  }
  .key-b {
    color: var(--info);
  }
  .mono-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .explorer {
      border-radius: 14px;
      padding: 18px;
      gap: 16px;
    }
    h2 {
      font-size: 20px;
    }
    .controls {
      padding: 14px;
      gap: 12px 16px;
    }
    .chips button {
      min-height: 44px;
    }
    .tiles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .tile {
      padding: 14px;
    }
    .tile.lead,
    .tile:last-child {
      grid-column: 1 / -1;
    }
    .v {
      font-size: 30px;
    }
    .v.sm {
      font-size: 22px;
    }
    .v.txt {
      font-size: 17px;
    }
    figure .plot-d {
      display: none;
    }
    figure .plot-m {
      display: block;
    }
    .foot {
      flex-direction: column;
      font-size: 13px;
    }
    .mono-note {
      font-size: 11px;
    }
  }
</style>
