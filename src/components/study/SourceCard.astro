---
// One dataset's trust score: ring with the overall score, a confidence badge
// and the five criteria as bars. On phones the bars fold away (first card open).
import { CRITERIA, overall, confidence, type Study } from '../../lib/studies';

interface Props {
  source: Study['data']['sources'][number];
  index: number;
}
const { source, index } = Astro.props;
const score = overall(source.scores);
const conf = confidence(score);
const ring = conf.tone === 'ok' ? 'var(--accent)' : 'var(--warn)';
const offset = (251 * (1 - score / 5)).toFixed(1);
const delay = (i: number) => `${(index * 0.3 + (i + 1) * 0.1).toFixed(1)}s`;
---

<article class="src-card">
  <div class="top">
    <svg role="img" aria-label={`Overall score ${score} out of 5`} viewBox="0 0 96 96" class="ring">
      <circle cx="48" cy="48" r="40" fill="none" stroke="#173538" stroke-width="8"></circle>
      <circle
        class="srcring"
        cx="48"
        cy="48"
        r="40"
        fill="none"
        stroke={ring}
        stroke-width="8"
        stroke-linecap="round"
        stroke-dasharray="251"
        stroke-dashoffset={offset}
        transform="rotate(-90 48 48)"
        style={`animation-delay:${index * 0.3}s`}></circle>
      <text
        class="srcnum"
        x="48"
        y="54"
        text-anchor="middle"
        font-family="IBM Plex Mono, monospace"
        font-size="22"
        font-weight="600"
        fill="#ECE6D6">{score.toFixed(1)}</text
      >
    </svg>
    <div class="who">
      <span class="name">{source.name}</span>
      <span class="pub">{source.publisher} · {source.kind}</span>
      <span class={`badge ${conf.tone}`}>{conf.label.toUpperCase()}</span>
    </div>
  </div>

  <details class="collapse hide-sum" open={index === 0}>
    <summary><span class="show">Show scores ▾</span><span class="hide">Hide scores ▴</span></summary>
    <dl>
      {
        CRITERIA.map((c, i) => {
          const v = source.scores[c.key];
          return (
            <div class="row">
              <dt>{c.label}</dt>
              <dd>
                <span
                  class="srcbar"
                  style={`width:${v * 20}%;background:${v <= 2 ? 'var(--warn)' : 'var(--accent)'};animation-delay:${delay(i)}`}
                />
              </dd>
              <span class="v">{v}</span>
            </div>
          );
        })
      }
    </dl>
    <p class="note"><span class="lbl">NOTE ›</span> {source.note}</p>
  </details>
</article>

<style>
  .src-card {
    flex: 1 1 460px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .ring {
    width: 88px;
    height: 88px;
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font-weight: 600;
  }
  .pub {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }
  .badge {
    align-self: flex-start;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .badge.ok {
    background: var(--ok-bg);
    color: var(--ok);
  }
  .badge.warn,
  .badge.weak {
    background: #43291a;
    color: var(--warn);
  }
  summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--link);
    list-style: none;
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .show,
  details:not([open]) .hide {
    display: none;
  }
  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  dt {
    width: 130px;
    flex: none;
    color: var(--text-2);
  }
  dd {
    margin: 0;
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: var(--bg-raised);
  }
  .srcbar {
    display: block;
    height: 100%;
    border-radius: 4px;
    transform-origin: left center;
  }
  .v {
    width: 28px;
    text-align: right;
    font-family: var(--font-mono);
  }
  .note {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-2);
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  /* Animate once the section scrolls into view (class added by the page script).
     Until then (and only when scripts run) hold the start state. */
  :global(.js) :global([data-reveal]:not(.in)) .srcbar {
    transform: scaleX(0);
  }
  :global(.js) :global([data-reveal]:not(.in)) .srcring {
    stroke-dashoffset: 251;
  }
  :global(.js) :global([data-reveal]:not(.in)) .srcnum {
    opacity: 0;
  }
  :global(.in) .srcbar {
    animation: srcfill 1.1s var(--ease) both;
  }
  :global(.in) .srcring {
    animation: srcring 1.4s var(--ease) both;
  }
  :global(.in) .srcnum {
    animation: srcfade 0.6s ease-out 1s both;
  }
  @keyframes srcfill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes srcring {
    from {
      stroke-dashoffset: 251;
    }
  }
  @keyframes srcfade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 761px) {
    :global(.js) .hide-sum > summary {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .src-card {
      flex-basis: auto;
      padding: 14px;
      gap: 10px;
    }
    .top {
      gap: 12px;
    }
    .ring {
      width: 56px;
      height: 56px;
    }
    .name {
      font-size: 15px;
    }
    .pub {
      font-size: 12px;
    }
    .badge {
      font-size: 11px;
      padding: 2px 7px;
      margin-top: 2px;
    }
    dl {
      gap: 8px;
      font-size: 13px;
    }
    .row {
      gap: 10px;
    }
    dt {
      width: 112px;
    }
    dd {
      height: 7px;
    }
    .v {
      width: 14px;
    }
    .note {
      margin-top: 10px;
      font-size: 13px;
    }
  }
</style>
