---
import Logo from './Logo.astro';
import { NAV, SITE } from '../site.config';
import { url, isActive } from '../lib/url';

interface Props {
  progress?: boolean; // thin reading-progress line under the bar (phones, long pages)
}
const { progress = false } = Astro.props;
const here = Astro.url.pathname;
---

<header class="site-header">
  <nav class="wrap bar" aria-label="Main">
    <a class="home" href={url()} aria-label="Pramana home">
      <Logo size={28} wordmark />
    </a>

    <a class="follow-m" href={SITE.xUrl} rel="me noopener" target="_blank">
      <span>Follow on X</span>
    </a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path class="l1" d="M3 7h18" ></path>
        <path class="l2" d="M3 12h18"></path>
        <path class="l3" d="M3 17h18"></path>
      </svg>
    </button>

    <div class="menu" id="site-menu">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(here, item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.soon && <span class="soon">soon</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary follow" href={SITE.xUrl} rel="me noopener" target="_blank">
        Follow on X
      </a>
    </div>
  </nav>
  {progress && <span class="prog" aria-hidden="true"></span>}
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        set(false);
        btn.focus();
      }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(16 40 43 / 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .home {
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 15px;
  }
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--text);
  }
  ul a[aria-current='page'] {
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .soon {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warn);
    border: 1px solid rgb(255 176 138 / 0.4);
    border-radius: 4px;
    padding: 0 5px;
    line-height: 1.6;
  }
  .follow {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 15px;
  }
  .follow-m {
    display: none;
    margin-left: auto;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }
  .follow-m span {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 7px;
  }
  .prog {
    display: none;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .menu-btn path {
    stroke: var(--text);
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.25s var(--ease), opacity 0.2s;
    transform-origin: 12px 12px;
  }
  .menu-btn[aria-expanded='true'] .l1 {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .l2 {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] .l3 {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .bar {
      min-height: 52px;
      gap: 14px;
    }
    .menu-btn,
    .follow-m {
      display: inline-flex;
    }
    .menu .follow {
      display: none;
    }
    @supports (animation-timeline: scroll()) {
      .prog {
        display: block;
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--accent);
        transform-origin: left;
        animation: prog linear both;
        animation-timeline: scroll(root);
      }
    }
    .menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 8px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 32px rgb(0 0 0 / 0.35);
    }
    .menu.open {
      display: flex;
      animation: drop 0.22s var(--ease);
    }
    ul {
      flex-direction: column;
      gap: 0;
    }
    ul a {
      width: 100%;
      font-size: 17px;
      padding: 6px 0;
      border-bottom: 1px solid var(--line);
    }
    ul a[aria-current='page'] {
      box-shadow: none;
      color: var(--accent);
    }
    .follow {
      min-height: 48px;
    }
  }
  @keyframes prog {
    from {
      transform: scaleX(0.04);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
