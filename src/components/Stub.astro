---
// Temporary page body used until each section is built in its own stage.
interface Props { eyebrow: string; title: string; stage: string; }
const { eyebrow, title, stage } = Astro.props;
---
<section class="grid-bg stub">
  <div class="wrap inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="muted"><slot /></p>
    <p class="mono note">Placeholder · built in {stage}</p>
  </div>
</section>
<style>
  .stub { border-bottom: 1px solid var(--line); }
  .inner { padding-block: clamp(56px, 10vw, 96px); display: flex; flex-direction: column; gap: 16px; }
  h1 { font-size: clamp(36px, 7vw, 56px); }
  .inner > p.muted { font-size: 18px; max-width: 640px; }
  .note { font-size: 12px; color: var(--warn); }
</style>
