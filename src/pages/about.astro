---
// About (mockup: About). Transparency first: how data and simulations are
// made, then a short "who I am" with a conflict-of-interest line.
// Changes from the mockup per CLAUDE.md: site header/menu; no email address
// (the private comment box replaces "Email me"); counters are counted from
// the site's real content (placeholders excluded) instead of example figures;
// personal details Shaurya has not written yet are visibly labelled.
import Base from '../layouts/Base.astro';
import CommentBox from '../components/CommentBox.astro';
import { allStudies } from '../lib/studies';
import { SITE } from '../site.config';
import { url } from '../lib/url';

const studies = await allStudies();
const real = studies.filter((s) => !s.data.placeholder);
const counters = [
  { label: 'studies published', value: real.length, color: 'var(--accent)' },
  { label: 'datasets rated', value: real.reduce((n, s) => n + s.data.sources.length, 0), color: 'var(--info)' },
  { label: 'corrections logged', value: real.reduce((n, s) => n + Math.max(0, s.data.revisions.length - 1), 0), color: 'var(--warn)' },
];
const example = studies.find((s) => s.id === 'calgary-rent-vs-wages');
const exampleUrl = example ? url(`studies/${example.id}/`) : url('studies/');

const STOPS = [
  { short: 'question', title: 'Ask the question', body: 'I write the question, and my prediction, before touching any data, in words that don’t assume the answer.', check: 'The question and prediction are timestamped on the study page.', artefact: 'THE LOGGED QUESTION' },
  { short: 'source', title: 'Find the sources', body: 'I go to the most direct official source first, note every alternative I considered, and say why I rejected it.', check: 'Every dataset is linked, with its publisher, geography, years and licence.', artefact: 'SOURCE LIST' },
  { short: 'rate', title: 'Rate each source', body: 'Each dataset is scored 1–5 on authority, published method, recency, fit to the question and independence.', check: 'The rubric is public, and every score has a one-line reason.', artefact: 'SOURCE CHECK' },
  { short: 'clean', title: 'Clean and align', body: 'Messy downloads get fixed: units, geographies, missing values, inflation. Every change is written down.', check: 'Download both the raw and cleaned files and compare them.', artefact: 'BEFORE / AFTER' },
  { short: 'model', title: 'Build the model', body: 'The simplest model that answers the question. No black boxes: the full code is a few readable lines.', check: 'The notebook is published next to the study.', artefact: 'THE MODEL' },
  { short: 'test', title: 'Try to break it', body: 'Backtest against a naive baseline, test every start year, and deliberately try to build the opposite headline.', check: 'The report card shows passes and failures alike.', artefact: 'REPORT CARD' },
  { short: 'publish', title: 'Publish and correct', body: 'Chart, data, code and caveats go out together. Mistakes are fixed in public, with what changed and when.', check: 'The revision log on every study, and the corrections count below.', artefact: 'FILES + REVISION LOG' },
];
const CRIT: [string, number][] = [['Authority', 5], ['Method published', 5], ['Recency', 4], ['Fit to question', 4], ['Independence', 5]];
const RAW = [
  ['Calgary (CMA) ', '2020', '"1,210.00"', 'warn', '', 'warn'],
  ['Calgary', '2021', 'n/a', '', '', 'bad'],
  ['CALGARY CMA', '2022', '1330', 'warn', '', ''],
  ['Calgary (CMA)', 'Oct-23', '1500 $', '', 'warn', 'warn'],
];
const CLEAN = [
  ['calgary_cma', '2020', '1210', 'ok', '', 'ok'],
  ['calgary_cma', '2021', '1230 *', 'ok', '', 'ok'],
  ['calgary_cma', '2022', '1330', 'ok', '', ''],
  ['calgary_cma', '2023', '1500', 'ok', 'ok', 'ok'],
];
const TRAIL = [
  { step: 'HEADLINE', value: '+48%', note: 'Calgary median rent, 2015 to 2025', border: 'var(--accent)' },
  { step: 'CALCULATION', value: '$1,700 ÷ $1,150 − 1 = 0.478', note: 'Rounded to the nearest whole percent', border: 'var(--line-control)' },
  { step: 'CLEAN TABLE', value: 'rent_vs_wages_clean.csv · rows 2015, 2025', note: 'Column: median_rent_2bed. Unchanged from the source apart from formatting.', border: 'var(--line-control)' },
  { step: 'ORIGINAL SOURCE', value: 'CMHC Rental Market Survey', note: 'Calgary CMA, 2-bedroom, October survey · source rating 4.6 · sample values', border: 'var(--ok)' },
];
const SEGS = [
  { name: 'Measured data', count: '4 inputs', items: 'Population, housing stock, median rent, median earnings (2019–2025).', w: 50, color: '#9FE0B8' },
  { name: 'Estimated from data', count: '2 inputs', items: 'Rent sensitivity to tightness; household size (2.5 people per home).', w: 25, color: '#9CD3F0' },
  { name: 'Assumptions', count: '2 inputs', items: 'Migration feedback factor (0.3) and the 30% affordability threshold. Both clearly labelled, both adjustable.', w: 25, color: '#FFB08A' },
];
const RULES = [
  { rule: 'The question comes before the data', proof: 'Each study shows the question and prediction with a timestamp from before the analysis.', color: '#FF7A3D' },
  { rule: 'Every chart ships with its data', proof: 'Look for the CSV, notebook and GitHub links on every study page.', color: '#9CD3F0' },
  { rule: 'Medians before averages', proof: 'Typical values use the median. If an average is shown, the reason is stated.', color: '#FFB08A' },
  { rule: 'Neutral words only', proof: 'Headlines are questions or plain statements. No “soaring”, no “crisis”.', color: '#ED93B1' },
  { rule: 'My stakes are disclosed', proof: 'A disclosure line appears on any study my own interests could touch.', color: '#E8D44D' },
  { rule: 'Mistakes are fixed in public', proof: 'Every study has a revision log, and total corrections are counted below.', color: '#9FE0B8' },
];
const ROLES = ['mechanical engineering student', 'finance student', 'data modeller', 'hardware tinkerer', 'Calgarian'];
---

<Base title="About" description="How the data and simulations on Pramana are found, checked and built, then who makes them.">
  <div class="ab">
    <section id="top" class="grid-bg hero-sec">
      <div class="wrap hero">
        <p class="eyebrow rise">About · transparency first</p>
        <h1 class="rise" style="animation-delay:.1s">Show your work.<span class="caret" aria-hidden="true"></span></h1>
        <p class="lead rise" style="animation-delay:.2s">
          Every number on this site travels the same line, from a question to a published chart. Here’s each stop, what
          happens there, and what you can check yourself. Who I am comes after, because the method matters more.
        </p>
        <div class="line-wrap rise" aria-hidden="true" style="animation-delay:.3s">
          <div class="track"></div>
          <div class="packet-run"><span class="packet"></span></div>
          <div class="stations">
            {STOPS.map((_, i) => <span class="station" style={`--d:${(i * 0.8).toFixed(2)}s`}>0{i + 1}</span>)}
          </div>
          <div class="shorts">{STOPS.map((s) => <span>{s.short}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- Part 1 · Open the hood -->
    <section class="wrap sec" data-hood>
      <div class="sh">
        <p class="part">PART 1 · HOW THE DATA AND SIMULATIONS ARE MADE</p>
        <h2>Open the hood</h2>
        <p class="muted">
          Pick a stop on the line. Each one shows the artefact it produces, using the <a href={exampleUrl}>rent-vs-wages study</a>{' '}as the example. That study is still a placeholder, so its values are samples.
        </p>
      </div>
      <div class="tabs" role="tablist" aria-label="Pipeline stops">
        {
          STOPS.map((s, i) => (
            <button type="button" role="tab" id={`stop-tab-${i}`} aria-controls={`stop-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-stop={i}>
              <span class="n">0{i + 1}</span> {s.title}
            </button>
          ))
        }
      </div>
      {
        STOPS.map((s, i) => (
          <div class="panel" role="tabpanel" id={`stop-${i}`} aria-labelledby={`stop-tab-${i}`} hidden={i !== 0}>
            <div class="p-text">
              <p class="part">STOP {i + 1} OF 7</p>
              <h3>{s.title}</h3>
              <p class="body">{s.body}</p>
              <div class="check"><span class="k warn">WHAT YOU CAN CHECK</span><span>{s.check}</span></div>
            </div>
            <div class="artefact">
              <p class="k">ARTEFACT · {s.artefact}</p>
              {i === 0 && (
                <div class="stack">
                  <p class="struck">“How bad has the rent crisis gotten?”</p>
                  <p class="q">“Has Calgary rent outpaced wages since 2020?”</p>
                  <div class="tags"><span>logged before any data</span><span>prediction: rent ahead (sample)</span></div>
                </div>
              )}
              {i === 1 && (
                <div class="stack">
                  {example?.data.datasets.map((d) => (
                    <div class="src"><span class="b">{d.name}</span><span class="m">{d.publisher} · {d.years} · {d.licence}</span></div>
                  ))}
                  <p class="small muted">Also considered and rejected: listing-site asking rents (not a random sample).</p>
                </div>
              )}
              {i === 2 && (
                <div class="stack tight">
                  <div class="score-row"><span class="b">Rental Market Survey</span><span class="score">4.6</span></div>
                  {CRIT.map(([n, v]) => (
                    <div class="crit"><span class="cn">{n}</span><span class="ct"><span style={`width:${v * 20}%`}></span></span><span class="cv">{v}</span></div>
                  ))}
                </div>
              )}
              {i === 3 && (
                <div class="stack" data-clean>
                  <div class="toggle2" role="group" aria-label="Table view">
                    <button type="button" class="raw" aria-pressed="true" data-view="raw">Raw download</button>
                    <button type="button" class="cln" aria-pressed="false" data-view="clean">After cleaning</button>
                  </div>
                  <div class="tw" data-table="raw">
                    <table><thead><tr><th>GEO</th><th>REF_DATE</th><th>VALUE</th></tr></thead>
                      <tbody>{RAW.map((r) => <tr><td class={r[3]}>{r[0]}</td><td class={r[4]}>{r[1]}</td><td class={r[5]}>{r[2]}</td></tr>)}</tbody></table>
                    <p class="small muted">Four spellings of one city, text in number fields, a missing year and a month-coded date.</p>
                  </div>
                  <div class="tw" data-table="clean" hidden>
                    <table><thead><tr><th>geo</th><th>year</th><th>median_rent</th></tr></thead>
                      <tbody>{CLEAN.map((r) => <tr><td class={r[3]}>{r[0]}</td><td class={r[4]}>{r[1]}</td><td class={r[5]}>{r[2]}</td></tr>)}</tbody></table>
                    <p class="small muted">One geography code, numbers as numbers, years as years. * 2021 filled from CMHC’s revised table, noted in the log.</p>
                  </div>
                </div>
              )}
              {i === 4 && (
                <div class="stack">
                  <p class="formula">index<sub>t</sub> = value<sub>t</sub> ÷ value<sub>2020</sub> × 100</p>
                  <p class="formula">gap = rent growth − wage growth</p>
                  <pre><span class="cm"># the whole model, no hidden steps</span>{'\n'}idx = df / df.loc[2020] * 100{'\n'}gap = idx["rent"] - idx["wage"]{'\n'}<span class="cm"># robustness: every start year</span>{'\n'}for y in range(2015, 2023):{'\n'}    check[y] = growth(df, y)</pre>
                </div>
              )}
              {i === 5 && (
                <div class="stack tight card-rows">
                  <div><span class="muted">Backtest error vs naive baseline</span><span class="mono">7.5% vs 12.6% <span class="okc">✓</span></span></div>
                  <div><span class="muted">Holds for every start year 2015–22?</span><span class="mono">yes <span class="okc">✓</span></span></div>
                  <div><span class="muted">Tried to build the opposite headline</span><span class="mono">failed <span class="okc">✓</span></span></div>
                  <div><span class="muted">Overfit risk</span><span class="mono warnc">stated: high for sandbox</span></div>
                  <p class="k">Sample values</p>
                </div>
              )}
              {i === 6 && (
                <div class="stack tight files">
                  <a href={example ? url(`studies/${example.id}/data.csv`) : '#'} download><span>{example?.id ?? 'study'}-data.csv</span><span class="go">↓</span></a>
                  <span class="off"><span>analysis.ipynb</span><span>not yet published</span></span>
                  <a href="https://github.com/sdbudyy/pramanadata.github.io" rel="noopener" target="_blank"><span>github.com/sdbudyy/pramanadata.github.io</span><span class="go">↗</span></a>
                  <span class="k" style="margin-top:6px">REVISIONS</span>
                  {example?.data.revisions.map((r) => <span class="mono small"><span class="m">{r.version}</span> {r.text}</span>)}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <!-- Trace a number -->
    <section class="band">
      <div class="wrap sec trace">
        <div class="tr-l">
          <p class="part">TRACE A NUMBER</p>
          <h2>Every figure has a paper trail</h2>
          <p class="muted">Tap the number to follow it all the way back to the source table. Every headline figure on the site works this way.</p>
          <button type="button" class="trace-btn" aria-expanded="false" aria-controls="trail">+48%</button>
          <span class="hint mono" data-hint>↑ tap me · sample values</span>
        </div>
        <div class="tr-r">
          <div class="trail" id="trail" hidden>
            {
              TRAIL.map((t, i) => (
                <div class="tstep">
                  {i > 0 && <span class="drop" style={`animation-delay:${(i * 0.35).toFixed(2)}s`}></span>}
                  <div class="tcard rise" style={`border-color:${t.border};animation-delay:${(i * 0.35 + 0.15).toFixed(2)}s`}>
                    <span class="k">{t.step}</span>
                    <span class="tv">{t.value}</span>
                    <span class="tn">{t.note}</span>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="empty" data-empty>The paper trail appears here ↓</div>
        </div>
      </div>
    </section>

    <!-- Simulations -->
    <section class="wrap sec" data-mix>
      <div class="sh">
        <p class="part">SIMULATIONS · COMING WITH THE SANDBOX</p>
        <h2>What’s measured, and what’s assumed</h2>
        <p class="muted">Sandbox models mix real data with estimates and assumptions. This is the planned breakdown for the rent-to-income model, and every model page will carry one.</p>
      </div>
      <div class="mixbar" role="img" aria-label={`Rent-to-income model inputs: ${SEGS.map((g) => `${g.name} ${g.w}%`).join(', ')}`}>
        {SEGS.map((g) => <div class="seg" style={`--w:${g.w}%;background:${g.color}`}><span>{g.name}</span></div>)}
      </div>
      <div class="mixcards">
        {
          SEGS.map((g, i) => (
            <button type="button" aria-pressed="false" data-seg={i} style={`--c:${g.color}`}>
              <span class="mh"><span class="sw"></span>{g.name} · {g.count}</span>
              <span class="mi">{g.items}</span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- Rules -->
    <section class="band">
      <div class="wrap sec">
        <div class="sh">
          <p class="part">MY RULES</p>
          <h2>Six promises. Flip each one for the proof.</h2>
        </div>
        <div class="rules">
          {
            RULES.map((r, i) => (
              <button type="button" class="flip" aria-pressed="false" style={`--c:${r.color}`}>
                <span class="flip-inner">
                  <span class="face front">
                    <span class="rn">0{i + 1}</span>
                    <span class="rr">{r.rule}</span>
                    <span class="rh">tap or hover to flip ↻</span>
                  </span>
                  <span class="face back">
                    <span class="rk">HOW YOU CAN TELL</span>
                    <span class="rp">{r.proof}</span>
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Part 2 · Who I am -->
    <section id="me" class="wrap sec me">
      <p class="part">PART 2 · WHO I AM</p>
      <div class="me-row">
        <div class="photo"><span class="ph-lbl">PLACEHOLDER</span>Photo to come</div>
        <div class="me-text">
          <h2>I’m {SITE.author},<br /><span class="acc">a <span class="role" data-role>{ROLES[0]}</span></span>.</h2>
          <p class="bio">
            I study Mechanical Engineering and Finance at the University of Calgary. I build hardware, model public data on
            Calgary, Alberta and Canada, and publish everything I find, method included.{' '}
            <span class="ph">[Placeholder: one line on what you’re looking for, e.g. internships, collaborators, data requests.]</span>
          </p>
          <p class="disc">
            <span class="k warn">DISCLOSURE ›</span>{' '}
            <span class="ph">[Placeholder: any personal stake, e.g. a family business in engineering or real estate. Flagged on every study it could touch.]</span>{' '}
            No sponsors, no paid posts.
          </p>
          <div class="counters">
            {counters.map((c) => (
              <div><span class="cv2" style={`color:${c.color}`} data-count={c.value}>{c.value}</span><span class="cl">{c.label}</span></div>
            ))}
          </div>
          <p class="k">Counted from the site itself. Placeholder studies aren’t counted. Corrections are counted on purpose.</p>
          <div class="me-btns">
            <a class="btn btn-primary" href="#contact">Send me a message</a>
            <a class="btn rep" href="#contact">Found a mistake? Report it</a>
            <a class="btn btn-ghost" href={SITE.xUrl} rel="me noopener" target="_blank">X</a>
            <a class="btn btn-ghost" href="https://github.com/sdbudyy" rel="me noopener" target="_blank">GitHub</a>
          </div>
        </div>
      </div>
      <div id="contact">
        <CommentBox topic="About page" heading="Send a private message" />
      </div>
    </section>
  </div>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pipeline tabs (arrow keys move between them, as tabs should).
  const hood = document.querySelector<HTMLElement>('[data-hood]');
  if (hood) {
    const tabs = [...hood.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...hood.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') pick((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') pick((i - 1 + tabs.length) % tabs.length, true);
      });
    });
    // Raw vs clean table
    const box = hood.querySelector<HTMLElement>('[data-clean]');
    box?.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        box.querySelectorAll('[data-view]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        box.querySelectorAll<HTMLElement>('[data-table]').forEach((t) => (t.hidden = t.dataset.table !== b.dataset.view));
      }),
    );
  }

  // Trace a number
  const tb = document.querySelector<HTMLButtonElement>('.trace-btn');
  if (tb) {
    const trail = document.getElementById('trail')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const hint = document.querySelector<HTMLElement>('[data-hint]')!;
    tb.addEventListener('click', () => {
      const open = tb.getAttribute('aria-expanded') !== 'true';
      tb.setAttribute('aria-expanded', String(open));
      trail.hidden = !open;
      empty.hidden = open;
      hint.textContent = open ? 'tap again to hide the trail · sample values' : '↑ tap me · sample values';
    });
  }

  // Simulation mix: pick a part to highlight it
  const mix = document.querySelector<HTMLElement>('[data-mix]');
  if (mix) {
    const cards = [...mix.querySelectorAll<HTMLButtonElement>('[data-seg]')];
    const segs = [...mix.querySelectorAll<HTMLElement>('.seg')];
    let on = -1;
    cards.forEach((c, i) =>
      c.addEventListener('click', () => {
        on = on === i ? -1 : i;
        cards.forEach((x, k) => x.setAttribute('aria-pressed', String(k === on)));
        segs.forEach((s, k) => (s.style.opacity = on === -1 || on === k ? '1' : '0.3'));
      }),
    );
    // Grow the bar once it scrolls into view
    new IntersectionObserver((es, io) => es.forEach((e) => { if (e.isIntersecting) { mix.classList.add('in'); io.disconnect(); } }), { threshold: 0.3 }).observe(mix);
  }

  // Rule cards flip on tap (hover also flips on devices that have it)
  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((f) =>
    f.addEventListener('click', () => f.setAttribute('aria-pressed', String(f.getAttribute('aria-pressed') !== 'true'))),
  );

  // Rotating role line
  const role = document.querySelector<HTMLElement>('[data-role]');
  if (role && !reduce) {
    const roles = ['mechanical engineering student', 'finance student', 'data modeller', 'hardware tinkerer', 'Calgarian'];
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % roles.length;
      role.textContent = roles[i];
      role.classList.remove('pop');
      void role.offsetWidth;
      role.classList.add('pop');
    }, 2400);
  }
</script>

<style>
  .ab {
    --x: 0;
  }
  :global(body:has(.ab) .site-footer) {
    margin-top: 0;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .k.warn {
    color: var(--warn);
  }
  .part {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .sec {
    padding-block: 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .band {
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .sh {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sh h2,
  .trace h2 {
    font-size: 40px;
  }
  .sh .muted {
    max-width: 720px;
  }
  .small {
    font-size: 14px;
  }
  .ab [hidden] {
    display: none !important;
  }
  .rise {
    animation: rise 0.6s var(--ease) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
  }

  /* ---------------- hero */
  .hero-sec {
    border-bottom: 1px solid var(--line);
  }
  .hero {
    padding-block: 96px 72px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .hero .eyebrow {
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: 80px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .caret {
    display: inline-block;
    width: 3px;
    height: 1em;
    background: var(--accent);
    vertical-align: -0.12em;
    margin-left: 4px;
    animation: blinkc 1s steps(1) infinite;
  }
  @keyframes blinkc {
    50% { opacity: 0; }
  }
  .lead {
    font-size: 20px;
    color: var(--text-2);
    max-width: 680px;
  }
  .line-wrap {
    position: relative;
    margin-top: 18px;
    padding: 0 12px;
    overflow-x: clip; /* the sliding packet's box must not widen the page */
    overflow-y: visible;
    padding-block: 8px;
    margin-block: 10px -8px;
  }
  .track {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 31px;
    height: 2px;
