    color: var(--accent);
  }
  .nb-text {
    font-size: 17px;
  }

  /* About */
  .about {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .ab-l {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ab-text {
    font-size: 18px;
  }
  .ab-l a {
    font-weight: 600;
  }
  .facts {
