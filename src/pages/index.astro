    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Follow on X (replaces the mockup's newsletter box) */
  .follow-in {
    padding-block: 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
    align-items: center;
    justify-content: space-between;
  }
  .f-text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .f-text h2 {
    font-size: 30px;
  }
  :global(body:has(.follow-sec) .site-footer) {
    margin-top: 0;
  }

  /* ---------- Phone ---------- */
  @media (max-width: 760px) {
    .hero {
      background-size: 32px 32px;
    }
    .hero-in {
      padding-block: 28px 28px;
      gap: 24px;
    }
    .hero-top {
      gap: 16px;
    }
    .hero-l,
    .hero-r {
      flex-basis: auto;
      gap: 12px;
    }
    h1 {
      font-size: 34px;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .lead {
      font-size: 16px;
    }
    .actions .btn {
      flex: 1 1 auto;
    }
    .hero-fig figure {
      border-radius: 14px;
      padding: 14px;
      gap: 10px;
    }
    .fig-title {
      font-size: 15px;
      line-height: 1.35;
    }
    .fig-meta {
      font-size: 11px;
    }
    .hero-fig svg.d {
