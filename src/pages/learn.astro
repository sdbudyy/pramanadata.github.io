---
// Learn: "Same numbers. Two stories." (mockups: Learn, LearnMobile).
// Seven interactive lessons with progress tracking and confetti on completion.
// Each lesson's HTML is drawn at build time from its starting state, then the
// browser redraws it on every interaction (src/lib/learn/).
// Changes from the mockup per CLAUDE.md: site header/menu, Follow on X instead
// of Subscribe, the Sandbox is "coming soon", and the placeholder "[yoursite]"
// stamp and "[CMHC, StatCan]" source are replaced with honest labels.
import Base from '../layouts/Base.astro';
import {
  tricksView, tricksInit, newsView, newsInit, newsBg, avmView, avmInit, corView, corInit,
  mkView, mkInit, honestBars, svView, svInit, quizView, quizInit, LESSONS,
} from '../lib/learn/lessons';
import { url } from '../lib/url';
import { SITE } from '../site.config';

const t = tricksView(tricksInit);
const nw = newsView(newsInit);
const av = avmView(avmInit);
const co = corView(corInit);
const mk = mkView(mkInit);
const sv = svView(svInit);
const qz = quizView(quizInit);
const learnUrl = new URL(url('learn/'), Astro.site).href;
const host = new URL(Astro.site!).host + url('learn/');
---

<Base title="Learn: same numbers, two stories" description="Seven short, interactive lessons on how honest data gets bent, and how to spot it.">
  <div class="lrn">
    <section id="top" class="grid-bg hero-sec">
      <div class="wrap hero">
        <p class="eyebrow rise">Learn · how data gets spun</p>
        <h1 class="rise" style="animation-delay:.1s">Same numbers.<br />Two stories.</h1>
        <div class="swap" aria-hidden="true">
          <p class="swapA">“Calgary rent is exploding.”</p>
          <p class="swapB">“Calgary rent has barely moved.”</p>
        </div>
        <p class="visually-hidden">Two opposite headlines: “Calgary rent is exploding” and “Calgary rent has barely moved.”</p>
        <p class="lead rise" style="animation-delay:.25s">
          Both headlines can be built from the exact same dataset. Here are the four most common tricks, two newsrooms
          spinning the same figure live, and a quick test of your own eye.
        </p>
        <a class="cta rise pulse" href="#tricks" style="animation-delay:.4s">See how it's done ↓</a>
      </div>
    </section>

    <!-- 1 · Four tricks -->
    <section id="tricks" class="wrap sec" data-lesson="l1">
      <div class="sh">
        <p class="part">PART 1</p>
        <h2>Four tricks, one dataset</h2>
        <p class="muted">Pick a trick, then flip between the two stories. The numbers never change, only the framing does.</p>
      </div>
      <div class="chips" role="tablist" aria-label="Tricks" data-slot="tabs" set:html={t.tabs} />
      <div class="split">
        <figure class="card fig3">
          <div class="modes" role="group" aria-label="Story" data-slot="modes" set:html={t.modes} />
          <p class="t-head" data-slot="headline" set:html={t.headline} />
          <div class="t-chart">
            <div class="t-axis" aria-hidden="true" data-slot="axis" set:html={t.axis} />
            <div class="t-plot" role="img" aria-label={t.chartLabel} data-label="chartLabel">
              <div class="t-bars" data-slot="bars" set:html={t.bars} />
              <div class="t-labels" data-slot="labels" set:html={t.labels} />
            </div>
          </div>
          <figcaption class="cap" data-slot="note" set:html={t.note} />
        </figure>
        <aside class="aside2">
          <div class="card pad">
            <p class="k">THE TRICK</p>
            <h3 data-slot="name" set:html={t.name} />
            <p class="muted" data-slot="what" set:html={t.what} />
          </div>
          <div class="card pad warn">
            <p class="k">HOW TO SPOT IT</p>
            <p data-slot="spot" set:html={t.spot} />
          </div>
          <div class="card pad ok">
            <p class="k">WHAT I DO INSTEAD</p>
            <p data-slot="fix" set:html={t.fix} />
          </div>
        </aside>
      </div>
    </section>

    <!-- 2 · Two newsrooms -->
    <section class="band">
      <div class="wrap sec" id="l2" data-lesson="l2">
        <div class="sh">
          <p class="part">PART 2</p>
          <h2>One number, two newsrooms</h2>
          <p class="muted">Set this year’s change in Calgary rent. Two reporters with opposite leanings get the same figure, and both find a way to tell their story.</p>
        </div>
        <div class="stick ctl ctl-bg">
          <label for="rentChange" class="k">RENT CHANGE THIS YEAR</label>
          <input id="rentChange" type="range" min="-6" max="12" step="0.5" value={newsInit.rent} data-act="rent" />
          <output for="rentChange" class="big" data-slot="out" set:html={nw.out} />
        </div>
        <div class="split">
          <article class="station" aria-label="Station A, leans alarming">
            <svg role="img" aria-label="Reporter at the Station A news desk, looking alarmed" viewBox="0 0 480 300">
              <rect x="0" y="0" width="480" height="300" fill={newsBg(newsInit.rent)} class="bgA"></rect>
              <rect x="250" y="34" width="196" height="120" rx="6" fill="#00000033" stroke="#FFB08A55"></rect>
              <g font-family="IBM Plex Mono, monospace"><text x="348" y="82" text-anchor="middle" font-size="30" font-weight="600" fill="#FFB08A" data-slot="numA" set:html={nw.numA} /><text x="348" y="110" text-anchor="middle" font-size="12" fill="#FFB08A">RENT</text><text x="348" y="134" text-anchor="middle" font-size="12" fill="#FFB08A" data-slot="arrowA" set:html={nw.arrowA} /></g>
              <g class="live"><rect x="20" y="20" width="58" height="22" rx="3" fill="#E24B4A"></rect><text x="49" y="35" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill="#FFFFFF">LIVE</text></g>
              <g class="bob">
                <rect x="96" y="176" width="140" height="110" rx="34" fill="#3B2A4A"></rect>
                <path d="M150 178 L166 214 L182 178 Z" fill="#ECE6D6"></path>
                <path d="M162 182 L166 230 L170 182 Z" fill="#E24B4A"></path>
                <rect x="154" y="150" width="24" height="30" rx="8" fill="#C98E6B"></rect>
                <circle cx="166" cy="124" r="40" fill="#D9A07C"></circle>
                <path d="M126 118 C128 78 204 74 206 118 C200 98 140 96 126 118 Z" fill="#2A1C14"></path>
                <g class="blink"><ellipse cx="152" cy="124" rx="5" ry="6" fill="#1A1A1A"></ellipse><ellipse cx="180" cy="124" rx="5" ry="6" fill="#1A1A1A"></ellipse></g>
                <path d="M142 110 L160 116 M190 110 L172 116" stroke="#2A1C14" stroke-width="3.5" stroke-linecap="round" fill="none"></path>
                <ellipse class="talk" cx="166" cy="146" rx="9" ry="7" fill="#5A1E1E"></ellipse>
                <rect class="wave" x="220" y="182" width="22" height="70" rx="11" fill="#3B2A4A"></rect>
                <circle class="wave" cx="231" cy="178" r="12" fill="#D9A07C"></circle>
              </g>
              <rect x="0" y="252" width="480" height="48" fill="#1A0F0C"></rect>
              <rect x="70" y="236" width="10" height="24" rx="3" fill="#888780"></rect><ellipse cx="75" cy="232" rx="10" ry="12" fill="#2C2C2A"></ellipse>
            </svg>
            <div class="banner"><span class="tag" style="background:#E24B4A">BREAKING</span><p data-slot="headA" set:html={nw.headA} /></div>
            <div class="tickwrap" style="background:#1A0F0C;border-top:1px solid #E24B4A55"><p class="ticker" style="color:#FFB08A" data-slot="tickA" set:html={nw.tickA} /></div>
            <div class="st-foot">
              <div class="st-top"><span class="st-name">STATION A</span><span class="lean" style="color:#FFB08A;border-color:#FFB08A66">LEANS ALARMING</span></div>
              <p class="left"><span class="k">WHAT THEY LEFT OUT ›</span> <span data-slot="leftA" set:html={nw.leftA} /></p>
            </div>
          </article>
          <article class="station" aria-label="Station B, leans reassuring">
            <svg role="img" aria-label="Reporter at the Station B news desk, looking calm and smiling" viewBox="0 0 480 300">
              <rect x="0" y="0" width="480" height="300" fill="#14324A"></rect>
              <rect x="34" y="34" width="196" height="120" rx="6" fill="#00000033" stroke="#9CD3F055"></rect>
              <g font-family="IBM Plex Mono, monospace"><text x="132" y="82" text-anchor="middle" font-size="30" font-weight="600" fill="#9CD3F0" data-slot="numB" set:html={nw.numB} /><text x="132" y="110" text-anchor="middle" font-size="12" fill="#9CD3F0">RENT</text><text x="132" y="134" text-anchor="middle" font-size="12" fill="#9CD3F0" data-slot="arrowB" set:html={nw.arrowB} /></g>
              <g class="live"><rect x="402" y="20" width="58" height="22" rx="3" fill="#378ADD"></rect><text x="431" y="35" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill="#FFFFFF">LIVE</text></g>
              <g class="bob2">
                <rect x="244" y="176" width="140" height="110" rx="34" fill="#22404F"></rect>
                <path d="M298 178 L314 214 L330 178 Z" fill="#ECE6D6"></path>
                <path d="M310 182 L314 230 L318 182 Z" fill="#378ADD"></path>
                <rect x="302" y="150" width="24" height="30" rx="8" fill="#8A5A3C"></rect>
                <circle cx="314" cy="124" r="40" fill="#A46B47"></circle>
                <path d="M272 128 C268 70 360 70 356 128 C354 104 344 92 314 90 C284 92 274 104 272 128 Z" fill="#1A1A1A"></path>
                <g class="blink"><ellipse cx="300" cy="124" rx="5" ry="5" fill="#1A1A1A"></ellipse><ellipse cx="328" cy="124" rx="5" ry="5" fill="#1A1A1A"></ellipse></g>
                <path d="M290 112 Q300 106 310 112 M318 112 Q328 106 338 112" stroke="#1A1A1A" stroke-width="3" stroke-linecap="round" fill="none"></path>
                <path class="talk" d="M302 142 Q314 154 326 142 Q314 150 302 142 Z" fill="#5A2E1E"></path>
              </g>
              <rect x="0" y="252" width="480" height="48" fill="#0B1E2C"></rect>
              <rect x="400" y="236" width="10" height="24" rx="3" fill="#888780"></rect><ellipse cx="405" cy="232" rx="10" ry="12" fill="#2C2C2A"></ellipse>
            </svg>
            <div class="banner" style="color:#0B1E2C"><span class="tag" style="background:#185FA5">TODAY</span><p data-slot="headB" set:html={nw.headB} /></div>
            <div class="tickwrap" style="background:#0B1E2C;border-top:1px solid #378ADD55"><p class="ticker" style="color:#9CD3F0" data-slot="tickB" set:html={nw.tickB} /></div>
            <div class="st-foot">
              <div class="st-top"><span class="st-name">STATION B</span><span class="lean" style="color:#9CD3F0;border-color:#9CD3F066">LEANS REASSURING</span></div>
              <p class="left"><span class="k">WHAT THEY LEFT OUT ›</span> <span data-slot="leftB" set:html={nw.leftB} /></p>
            </div>
          </article>
        </div>
        <div class="honest" role="status">
          <div class="h-l">
            <p class="k" style="color:var(--ok)">THE HONEST VERSION</p>
            <p class="h-head" data-slot="honest" set:html={nw.honest} />
            <p class="small muted">Context both stations had: wages rose +3.0% and prices rose +2.5% this year (illustrative).</p>
          </div>
          <dl class="h-r">
            <div><dt>VS WAGES</dt><dd data-slot="vsWage" set:html={nw.vsWage} /></div>
            <div><dt>AFTER INFLATION</dt><dd data-slot="real" set:html={nw.real} /></div>
          </dl>
        </div>
        <p class="fine-note">Both stations are fictional. Every headline above is technically defensible, which is exactly the problem.</p>
      </div>
    </section>

    <!-- 3 · Average vs median -->
    <section class="wrap sec" id="l3" data-lesson="l3">
      <div class="sh">
        <p class="part">PART 3</p>
        <h2>Average vs median: one person changes everything</h2>
        <p class="muted">Ten Calgary renters and their incomes. Invite one very high earner into the room, then read the two press releases written about the same eleven people.</p>
      </div>
      <div class="stick ctl ctl-panel">
        <span data-slot="toggle" set:html={av.toggle} />
        <label for="hiIncome" class="k">THEIR INCOME</label>
        <input id="hiIncome" type="range" min="200" max="5000" step="50" value={avmInit.hi} data-act="hi" />
        <output for="hiIncome" class="mid" data-slot="out" set:html={av.out} />
      </div>
      <div class="split">
        <figure class="card fig3">
          <div class="avm-key" data-slot="key" set:html={av.key} />
          <div class="avm" role="img" aria-label={av.chartLabel} data-label="chartLabel" data-slot="chart" set:html={av.chart} />
          <figcaption class="cap" data-slot="caption" set:html={av.caption} />
        </figure>
        <div class="aside2">
          <article class="press" style="--sh:#FF7A3D;--ink:#6B4A2A">
            <p class="pk">PRESS RELEASE · PROPERTY OWNERS’ GROUP (FICTIONAL)</p>
            <p class="pq" data-slot="pr1" set:html={av.pr1} />
            <p class="pu">Uses: the average</p>
          </article>
          <article class="press" style="--sh:#9CD3F0;--ink:#1F4A66">
            <p class="pk">PRESS RELEASE · RENTERS’ COALITION (FICTIONAL)</p>
            <p class="pq" data-slot="pr2" set:html={av.pr2} />
            <p class="pu">Uses: the median</p>
          </article>
          <div class="okbox">
            <p class="k" style="color:var(--ok)">THE HONEST VERSION</p>
            <p data-slot="honest" set:html={av.honest} />
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · Correlation -->
    <section class="band">
      <div class="wrap sec" id="l4" data-lesson="l4">
        <div class="sh">
          <p class="part">PART 4</p>
          <h2>Correlation isn’t causation</h2>
          <p class="muted">Pick a pair. They move together, and a viral post says one causes the other. Then strip out the shared pattern and see what’s left.</p>
        </div>
        <div class="cor-ctl">
          <div class="opts" data-slot="pairs" set:html={co.pairs} />
          <span data-slot="toggle" set:html={co.toggle} />
        </div>
        <div class="split">
          <figure class="card fig3 dark">
            <div class="cor-head">
              <figcaption data-slot="title" set:html={co.title} />
              <span class="mono r">correlation r = <span data-slot="r" set:html={co.r} /></span>
            </div>
            <svg class="cor-svg" role="img" aria-label={co.chartLabel} data-label="chartLabel" viewBox="0 0 640 260">
              <g stroke="#24474A" stroke-width="1"><line x1="40" y1="20" x2="600" y2="20"></line><line x1="40" y1="120" x2="600" y2="120"></line><line x1="40" y1="220" x2="600" y2="220"></line></g>
              <g data-slot="lines" set:html={co.lines} />
            </svg>
            <div class="legend" data-slot="legend" set:html={co.legend} />
          </figure>
          <div class="aside2">
            <article class="viral">
              <div class="v-top"><span class="avatar"></span><div><span class="v-name">TotallyRealFacts</span><span class="v-handle">@totally_real_facts · fictional</span></div></div>
              <p class="v-text" data-slot="viral" set:html={co.viral} />
              <p class="v-meta">↻ shared · ♡ liked · 1 chart, 0 sources</p>
              <div data-slot="stamp" set:html={co.stamp} />
            </article>
            <div class="card pad dark">
              <p class="k">WHAT’S REALLY CONNECTING THEM</p>
              <div class="diagram" role="img" aria-label={co.diagramLabel} data-label="diagramLabel" data-slot="diagram" set:html={co.diagram} />
              <p class="muted small2" data-slot="lesson" set:html={co.lesson} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Make it misleading -->
    <section class="wrap sec" id="l5" data-lesson="l5">
      <div class="sh">
        <p class="part">PART 5</p>
        <h2>Make it misleading</h2>
        <p class="muted">Your turn to spin. Choose the story you want to sell, stack the tricks, and watch the spin meter climb. The honest chart stays next to yours the whole time.</p>
      </div>
      <div class="mk">
        <div class="mkL">
          <div class="mkGoals">
            <p class="k">1 · THE STORY YOU’RE SELLING</p>
            <div class="goals" data-slot="goals" set:html={mk.goals} />
          </div>
          <div class="mkTricks">
            <p class="k">2 · STACK THE TRICKS</p>
            <div class="tks" data-slot="tricks" set:html={mk.tricks} />
          </div>
        </div>
        <div class="mkR">
          <div class="mkMeter">
            <svg class="meter" role="img" aria-label={mk.meterLabel} data-label="meterLabel" viewBox="0 0 200 116">
              <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="#173538" stroke-width="16" stroke-linecap="round"></path>
              <g data-slot="meterArc" set:html={mk.meterArc} />
              <text x="100" y="92" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="30" font-weight="600" fill="#ECE6D6" data-slot="score" set:html={mk.score} />
              <text x="100" y="112" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#8FA6A0">SPIN METER</text>
            </svg>
            <div class="verdict" data-slot="verdict" set:html={mk.verdict} />
          </div>
          <div class="mkFigs">
            <figure class="paper">
              <p class="pk2">YOUR CHART</p>
              <p class="yh" data-slot="headline" set:html={mk.headline} />
              <div class="ychart">
                <div class="yaxis" aria-hidden="true" data-slot="axis" set:html={mk.axis} />
                <div class="ybars" role="img" aria-label="Your chart of rent by year, 2015 to 2025" data-slot="bars" set:html={mk.bars} />
              </div>
              <p class="pk2" data-slot="foot" set:html={mk.foot} />
              <div class="madeit">I MADE THIS MISLEADING ON PURPOSE · {host}</div>
            </figure>
            <figure class="honestfig">
              <p class="k" style="color:var(--ok)">THE HONEST CHART</p>
              <p class="hf-h">Rent +48% since 2015; wages +16%</p>
              <div class="hbars" role="img" aria-label="Honest chart: rent from $1,150 in 2015 to $1,700 in 2025, axis from zero">
                {honestBars.map((h) => <span style={`height:${h}%`}></span>)}
              </div>
              <p class="hf-f">Full range · axis from $0 · wages shown · illustrative data</p>
            </figure>
          </div>
          <div class="mkBtns">
            <button type="button" class="b-acc" data-act="download">Download image</button>
            <a class="b-ghost" data-share href={`https://x.com/intent/post?text=${encodeURIComponent('I made this chart misleading on purpose. See how easy it is:')}&url=${encodeURIComponent(learnUrl + '#l5')}`} rel="noopener" target="_blank">Post to X</a>
            <button type="button" class="b-ghost" data-act="reset">Undo all the spin</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · Biased surveys -->
    <section class="band">
      <div class="wrap sec" id="l6" data-lesson="l6">
        <div class="sh">
          <p class="part" style="color:var(--ok)">PART 6</p>
          <h2>Where you ask decides what you hear</h2>
          <p class="muted">200 Calgarians are out and about. You want to know how many take transit to work. Choose where to run your 25-person survey, then compare it with the truth.</p>
        </div>
        <div class="stick stick6">
          <span class="k">RUN THE SURVEY:</span>
          <span class="spots" data-slot="spots" set:html={sv.spots} />
          <span class="grow"></span>
          <span data-slot="reveal" set:html={sv.reveal} />
        </div>
        <div class="split">
          <figure class="card fig3 dark tight">
            <svg role="img" aria-label={sv.fieldLabel} data-label="fieldLabel" viewBox="0 0 640 360" class="field">
              <rect x="0" y="0" width="640" height="360" rx="12" fill="#0B2023"></rect>
              <g stroke="#ECE6D60A"><line x1="0" y1="120" x2="640" y2="120"></line><line x1="0" y1="240" x2="640" y2="240"></line><line x1="213" y1="0" x2="213" y2="360"></line><line x1="426" y1="0" x2="426" y2="360"></line></g>
              <g data-slot="zones" set:html={sv.zones} />
              <text x="36" y="44" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill="#FF9A66">C-TRAIN STATION</text>
              <text x="448" y="328" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill="#ED93B1">MALL PARKING LOT</text>
              <g data-slot="dots" set:html={sv.dots} />
            </svg>
            <div class="legend small">
              <span><span style="color:#FF7A3D">●</span> takes transit</span><span><span style="color:#9CD3F0">●</span> doesn’t</span><span><span style="color:#4A7176">●</span> not asked yet</span>
              <span class="mnote">Illustrative crowd · truth: {sv.truth} take transit</span>
            </div>
          </figure>
          <div class="aside2">
            <article class="report" data-style="shadow" style={sv.shadow} data-slot="report" set:html={sv.report} />
            <div class="card pad dark">
              <p class="k">YOUR SURVEY VS THE WHOLE CITY</p>
              <div class="res" data-slot="result" set:html={sv.result} />
              <p class="gapline" data-slot="gap" set:html={sv.gap} />
              <p class="muted small2" data-slot="lesson" set:html={sv.lesson} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · Spot the trick -->
    <section class="wrap sec" id="l7" data-lesson="l7">
      <div class="sh">
        <p class="part">PART 7</p>
        <h2>Spot the trick</h2>
        <p class="muted">A real-looking headline. What's wrong with it?</p>
      </div>
      <div class="split">
        <figure class="card fig-even">
          <p class="spot-h">“Break-ins on our street up 300%!”</p>
          <div class="spot-chart" role="img" aria-label="Bar chart: 2 break-ins last year, 8 this year">
            <div><span>2</span><span class="sb" style="height:25%;background:#4A7176"></span></div>
            <div><span>8</span><span class="sb" style="height:100%;background:var(--accent)"></span></div>
          </div>
          <div class="spot-l"><span>Last year</span><span>This year</span></div>
        </figure>
        <div class="quiz">
          <div class="qopts" data-slot="opts" set:html={qz.opts} />
          <div data-slot="feedback" set:html={qz.feedback} />
        </div>
      </div>
    </section>

    <section id="end" class="band end">
      <div class="wrap end-in">
        <div class="end-t">
          <h2>Now try it yourself</h2>
          <p class="muted">Read a study and check my method, or follow along on X. The sandbox, where you build a model and push its assumptions, is coming soon.</p>
        </div>
        <div class="end-b">
          <a class="btn btn-primary" href={url('studies/')}>Read a study</a>
          <a class="btn btn-ghost" href={SITE.xUrl} rel="me noopener" target="_blank">Follow on X</a>
        </div>
      </div>
    </section>

    <!-- Progress: side tab on desktop, bottom pill on phones -->
    <div class="prog-side" data-prog>
      <div class="hint" role="status" hidden><strong>7 quick lessons.</strong> Track your progress and jump to any part from here →</div>
      <div class="panel" role="region" aria-label="Lesson progress" hidden>
        <div class="p-top"><span class="k">JUMP TO A LESSON</span><span class="count"><span data-count>0</span> / 7</span></div>
        <div class="p-track" aria-hidden="true"><div class="rainbow" data-pct></div></div>
        <ol>
          <li><a href="#top" class="jump"><span class="ic">↑</span>Back to the top</a></li>
          {LESSONS.map((l, i) => (
            <li><a href={`#${l.id}`} class="jump" data-badge={l.key} style={`--c:${l.color}`}><span class="ic b">{i + 1}</span>{l.name}</a></li>
          ))}
        </ol>
      </div>
      <button type="button" class="tab" aria-expanded="false" aria-label="Lesson progress, 0 of 7 complete">
        {LESSONS.map((l) => <span class="dot" data-dot={l.key} style={`--c:${l.color}`}></span>)}
        <span class="tc"><span data-count>0</span>/7</span>
      </button>
    </div>

    <div class="prog-bar" data-prog>
      <div class="sheet" role="region" aria-label="Lesson progress" hidden>
        <div class="p-top"><span class="k">JUMP TO A LESSON</span><span class="count"><span data-count>0</span> / 7</span></div>
        <div class="p-track" aria-hidden="true"><div class="rainbow" data-pct></div></div>
        <ol>
          <li><a href="#top" class="jump"><span class="ic">↑</span>Back to the top</a></li>
          {LESSONS.map((l, i) => (
            <li><a href={`#${l.id}`} class="jump" data-badge={l.key} style={`--c:${l.color}`}><span class="ic b">{i + 1}</span>{l.name}</a></li>
          ))}
        </ol>
      </div>
      <div class="hint" role="status" hidden><strong>7 quick lessons.</strong> Tap below to track progress and jump around ↓</div>
      <button type="button" class="pill" aria-expanded="false" aria-label="Lesson progress, 0 of 7 complete">
        <span class="dots">{LESSONS.map((l) => <span class="dot" data-dot={l.key} style={`--c:${l.color}`}></span>)}</span>
        <span class="tc"><span data-count>0</span>/7</span><span class="muted">lessons</span>
      </button>
    </div>

    <div class="celebrate" hidden>
      <div class="confetti-box" aria-hidden="true"></div>
      <div role="dialog" aria-modal="true" aria-labelledby="congrats-title" class="congrats">
        <div class="badges">{LESSONS.map((l) => <span style={`background:${l.color}`}>✓</span>)}</div>
        <h2 id="congrats-title">Congratulations!</h2>
        <p class="c1">You’re now a little more educated, and a lot harder to fool with data.</p>
        <p class="muted">You can spot a cropped axis, a cherry-picked window, a skewed average, a fake correlation, a spun headline and a biased sample.</p>
        <div class="c-btns">
          <a class="btn btn-primary" href={url('studies/')}>Put it to work on a study</a>
          <button type="button" class="btn btn-ghost" data-close>Close</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import {
    tricksView, tricksInit, newsView, newsInit, newsBg, avmView, avmInit, corView, corInit,
    mkView, mkInit, mkModel, svView, svInit, quizView, quizInit, LESSONS, type MkS, type TrickKey,
  } from '../lib/learn/lessons';
  import { mount, markDone } from '../lib/learn/core';

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const lesson = (k: string) => $(`[data-lesson="${k}"]`);
  // Some lesson views also return values for attributes (aria-labels and the like).
  const labels = (root: HTMLElement, v: Record<string, string>) =>
    root.querySelectorAll<HTMLElement>('[data-label]').forEach((el) => {
      const k = el.dataset.label!;
      if (k in v) el.setAttribute('aria-label', v[k].replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>'));
    });
  const phone = window.matchMedia('(max-width: 760px)');

  // 1 · Tricks
  {
    const root = lesson('l1');
    mount(root, tricksInit, tricksView, (s, name, arg) => {
      if (name === 'trick') return { trick: Number(arg), mode: 'a' as const };
      if (name === 'mode') {
        if (arg === 'h') markDone('l1');
        return { mode: arg as 'a' | 'b' | 'h' };
      }
    }, (s, v) => labels(root, v));
  }

  // 2 · Newsrooms
  {
    const root = lesson('l2');
    const bg = root.querySelector('.bgA')!;
    mount(root, newsInit, newsView, (s, name, arg, el) => {
      if (name === 'rent') {
        markDone('l2');
        return { rent: Number((el as HTMLInputElement).value) };
      }
    }, (s) => bg.setAttribute('fill', newsBg(s.rent)));
  }

  // 3 · Average vs median (shorter chart on phones)
  {
    const root = lesson('l3');
    const input = $<HTMLInputElement>('#hiIncome', root);
    const m = mount(root, { ...avmInit, compact: phone.matches }, avmView, (s, name, arg, el) => {
      if (name === 'toggle') { markDone('l3'); return { hiOn: !s.hiOn }; }
      if (name === 'hi') { markDone('l3'); return { hi: Number((el as HTMLInputElement).value), hiOn: true }; }
    }, (s, v) => { labels(root, v); input.value = String(s.hi); });
    phone.addEventListener('change', () => m.set({ compact: phone.matches }));
  }

  // 4 · Correlation
  {
    const root = lesson('l4');
    mount(root, corInit, corView, (s, name, arg) => {
      if (name === 'pair') return { pair: Number(arg), detrend: false };
      if (name === 'detrend') { markDone('l4'); return { detrend: !s.detrend }; }
    }, (s, v) => labels(root, v));
  }

  // 5 · Make it misleading
  {
    const root = lesson('l5');
    const m = mount(root, mkInit, mkView, (s, name, arg) => {
      if (name === 'goal') return { goal: arg as MkS['goal'] };
      if (name === 'trick') {
        markDone('l5');
        const k = arg as TrickKey;
        return { tricks: { ...s.tricks, [k]: !s.tricks[k] } };
      }
      if (name === 'reset') return { tricks: { ...mkInit.tricks } };
      if (name === 'download') { download(s); return null; }
    }, (s, v) => labels(root, v));
    void m;

    // Draw "your chart" to a PNG, stamp and all, so it can be shared.
    function download(s: MkS) {
      const M = mkModel(s);
      const W = 1200, H = 675, c = document.createElement('canvas');
      c.width = W; c.height = H;
      const g = c.getContext('2d')!;
      g.fillStyle = '#ECE6D6'; g.fillRect(0, 0, W, H);
      g.fillStyle = '#5F5E5A'; g.font = '600 20px "IBM Plex Mono", monospace'; g.fillText('YOUR CHART', 56, 70);
      g.fillStyle = M.headCol; g.font = '700 40px "IBM Plex Sans", sans-serif';
      const words = M.head.split(' '); let line = '', y = 124;
      for (const w of words) { const t = line ? line + ' ' + w : w; if (g.measureText(t).width > W - 112) { g.fillText(line, 56, y); line = w; y += 48; } else line = t; }
      g.fillText(line, 56, y);
      const top = y + 40, bottom = H - 120, left = 150, right = W - 56;
      g.fillStyle = '#5F5E5A'; g.font = '18px "IBM Plex Mono", monospace'; g.textAlign = 'right';
      g.fillText('$' + Math.round(M.hi).toLocaleString('en-CA'), left - 14, top + 14);
      g.fillText('$' + Math.round(M.lo).toLocaleString('en-CA'), left - 14, bottom);
      g.textAlign = 'left';
      g.strokeStyle = '#888780'; g.lineWidth = 2; g.beginPath(); g.moveTo(left, top); g.lineTo(left, bottom); g.lineTo(right, bottom); g.stroke();
      const n = M.bars.length, gap = 8, bw = (right - left - gap * (n + 1)) / n;
      M.bars.forEach((b, i) => {
        const h = ((bottom - top) * b.h) / 100;
        g.globalAlpha = b.op; g.fillStyle = M.barCol;
        g.fillRect(left + gap + i * (bw + gap), bottom - h, bw, h);
      });
      g.globalAlpha = 1;
      g.fillStyle = '#5F5E5A'; g.font = '18px "IBM Plex Mono", monospace'; g.fillText(M.foot, 56, H - 76);
      g.save(); g.translate(56, H - 34); g.rotate(-0.03);
      g.strokeStyle = '#A32D2D'; g.fillStyle = '#A32D2D'; g.lineWidth = 3; g.font = '700 20px "IBM Plex Mono", monospace';
      const stamp = 'I MADE THIS MISLEADING ON PURPOSE · ' + location.host + location.pathname.replace(/\/$/, '');
      const sw = g.measureText(stamp).width;
      g.strokeRect(-8, -24, sw + 16, 34); g.fillText(stamp, 0, 0); g.restore();
      c.toBlob((blob) => {
        if (!blob) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'misleading-on-purpose.png';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      });
    }
  }

  // 6 · Surveys
  {
    const root = lesson('l6');
    const card = $('.report', root);
    mount(root, svInit, svView, (s, name, arg) => {
      if (name === 'poll') { if (arg === 'random') markDone('l6'); return { poll: arg, fine: false }; }
      if (name === 'reveal') return { reveal: !s.reveal };
      if (name === 'fine') return { fine: !s.fine };
    }, (s, v) => {
      labels(root, v);
      card.setAttribute('style', v.shadow);
    });
  }

  // 7 · Spot the trick
  {
    const root = lesson('l7');
    mount(root, quizInit, quizView, (s, name, arg) => {
      if (name === 'pick') { markDone('l7'); return { pick: Number(arg) }; }
    });
  }

  // ------------------------------------------------------------ Progress
  const KEY = 'pramana-learn-done';
  const read = (): Set<string> => { try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { return new Set(); } };
  const done = read();
  let celebrated = done.size === 7;
  const bars = document.querySelectorAll<HTMLElement>('[data-prog]');
  const paint = () => {
    document.querySelectorAll('[data-count]').forEach((el) => (el.textContent = String(done.size)));
    document.querySelectorAll<HTMLElement>('[data-pct]').forEach((el) => (el.style.width = `${(done.size / 7) * 100}%`));
    document.querySelectorAll<HTMLElement>('[data-dot]').forEach((el) => el.classList.toggle('on', done.has(el.dataset.dot!)));
    document.querySelectorAll<HTMLElement>('[data-badge]').forEach((el) => {
      const on = done.has(el.dataset.badge!);
      el.classList.toggle('on', on);
      const ic = el.querySelector('.ic')!;
      ic.textContent = on ? '✓' : String(LESSONS.findIndex((l) => l.key === el.dataset.badge) + 1);
    });
    bars.forEach((b) => b.querySelector('button')!.setAttribute('aria-label', `Lesson progress, ${done.size} of 7 complete`));
  };
  paint();

  const celebrate = $('.celebrate');
  const showCelebrate = () => {
    const box = $('.confetti-box', celebrate);
    const cols = ['#FF7A3D', '#E24B4A', '#FFB08A', '#9CD3F0', '#ED93B1', '#9FE0B8', '#E8D44D', '#ECE6D6'];
    box.innerHTML = Array.from({ length: 90 }, () => {
      const r = Math.random;
      return `<span class="confetti" style="left:${(r() * 100).toFixed(1)}%;width:${Math.round(6 + r() * 8)}px;height:${Math.round(8 + r() * 10)}px;background:${cols[Math.floor(r() * cols.length)]};border-radius:${r() > 0.6 ? '50%' : '2px'};animation-duration:${(2.4 + r() * 2.4).toFixed(2)}s;animation-delay:${(r() * 1.4).toFixed(2)}s"></span>`;
    }).join('');
    celebrate.hidden = false;
    $<HTMLButtonElement>('[data-close]', celebrate).focus();
  };
  const closeCelebrate = () => { celebrate.hidden = true; };
  $('[data-close]', celebrate).addEventListener('click', closeCelebrate);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !celebrate.hidden) closeCelebrate(); });

  document.addEventListener('lesson-done', (e) => {
    const k = (e as CustomEvent<string>).detail;
    if (done.has(k)) return;
    done.add(k);
    try { localStorage.setItem(KEY, JSON.stringify([...done])); } catch {}
    paint();
    if (done.size === 7 && !celebrated) { celebrated = true; setTimeout(showCelebrate, 500); }
  });

  // Open/close: hover or click on desktop, tap on phones.
  bars.forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('button')!;
    const panel = wrap.querySelector<HTMLElement>('.panel, .sheet')!;
    const hint = wrap.querySelector<HTMLElement>('.hint')!;
    let pinned = false;
    const set = (open: boolean) => { panel.hidden = !open; btn.setAttribute('aria-expanded', String(open)); if (open) hint.hidden = true; wrap.classList.toggle('open', open); };
    btn.addEventListener('click', () => { pinned = !pinned; set(pinned); btn.classList.remove('nudge'); });
    if (wrap.classList.contains('prog-side')) {
      wrap.addEventListener('mouseenter', () => set(true));
      wrap.addEventListener('mouseleave', () => { if (!pinned) set(false); });
    }
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { pinned = false; set(false); }));
  });

  // First visit: nudge the progress control once, near the top of the page.
  try {
    if (localStorage.getItem('learnNudged') !== '1') {
      setTimeout(() => {
        if (window.scrollY > 500) return;
        localStorage.setItem('learnNudged', '1');
        bars.forEach((wrap) => {
          if (getComputedStyle(wrap).display === 'none') return;
          const hint = wrap.querySelector<HTMLElement>('.hint')!;
          const btn = wrap.querySelector('button')!;
          hint.hidden = false;
          btn.classList.add('nudge');
          setTimeout(() => { hint.hidden = true; btn.classList.remove('nudge'); }, 6500);
        });
      }, 1800);
    }
  } catch {}

  // Pause looping animations in sections that are off screen (saves battery on phones).
  const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('paused', !e.isIntersecting)), { rootMargin: '100px' });
  document.querySelectorAll('.lrn section').forEach((s) => io.observe(s));
</script>

