    border-radius: 4px 4px 0 0;
    transition: height 0.8s var(--ease), background-color 0.5s, opacity 0.5s;
  }
  .t-labels {
    display: flex;
    gap: 8px;
    padding: 0 8px;
  }
  .t-labels :global(span) {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
  }

  /* ----------------------------------------------------------- controls */
  .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    border: 1px solid var(--line-control);
    border-radius: 16px;
    padding: 20px 24px;
  }
  .ctl-bg {
    background: var(--bg);
  }
  .ctl-panel {
    background: var(--bg-alt);
    padding: 18px 22px;
  }
  .ctl input[type='range'] {
    flex: 1 1 300px;
    min-width: 0;
  }
  .big {
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 600;
    min-width: 120px;
    text-align: right;
    color: var(--accent);
  }
  .mid {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    min-width: 110px;
    text-align: right;
    color: var(--accent);
  }

  /* ----------------------------------------------------------- 2 newsrooms */
  .station {
    flex: 1 1 460px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }
  .station svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .bgA {
    transition: fill 0.6s;
  }
  .banner {
    display: flex;
    align-items: stretch;
    background: #fff;
    color: #1a0f0c;
  }
  .banner .tag {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 12px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .banner p {
    padding: 10px 14px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .tickwrap {
    overflow: hidden;
  }
  .ticker {
    display: inline-block;
    white-space: nowrap;
    padding: 6px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    animation: ticker 18s linear infinite;
  }
  @keyframes ticker {
    to { transform: translateX(-50%); }
  }
  .st-foot {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .st-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
  .st-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  .lean {
    font-family: var(--font-mono);
    font-size: 12px;
    border: 1px solid;
    padding: 1px 8px;
    border-radius: 4px;
  }
  .left {
    font-size: 15px;
    color: var(--text-2);
  }
  .honest {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    border: 1px solid var(--ok);
    background: var(--ok-bg);
    border-radius: 16px;
    padding: 22px 24px;
  }
  .h-l {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .h-head {
    font-size: 19px;
    font-weight: 600;
  }
  .h-r {
    flex: 1 1 300px;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .h-r div {
    flex: 1 1 120px;
    border: 1px solid rgb(159 224 184 / 0.35);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .h-r dt {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok);
  }
  .h-r dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
  }
  /* Reporter animations */
  .bob { animation: bob 1.6s ease-in-out infinite; }
  .bob2 { animation: bob 2.6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-4px); } }
  .talk { transform-box: fill-box; transform-origin: center; animation: talk 0.28s ease-in-out infinite; }
  @keyframes talk { 50% { transform: scaleY(0.35); } }
  .blink { transform-box: fill-box; transform-origin: center; animation: blink 4s infinite; }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  .wave { transform-box: fill-box; transform-origin: 50% 90%; animation: wave 0.9s ease-in-out infinite; }
  @keyframes wave { 50% { transform: rotate(-14deg); } }
  .live { animation: live 1.2s ease-in-out infinite; }
  @keyframes live { 50% { opacity: 0.45; } }

  /* ----------------------------------------------------------- 3 avg/median */
  .ctl :global(.btn-on),
  .ctl :global(.btn-off) {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1px solid var(--accent);
    font-size: 15px;
    font-weight: 600;
  }
  .ctl :global(.btn-on) {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .ctl :global(.btn-off) {
    background: transparent;
    color: var(--text);
  }
  .avm {
    position: relative;
    height: 580px;
    border-bottom: 1px solid var(--line-control);
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 0 8px;
  }
  .avm :global(.pcol) {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    transition: opacity 0.5s;
  }
  .avm :global(.plabel) {
    position: relative; /* sits above the average/median lines */
    z-index: 1;
    background: var(--bg-alt);
    padding: 0 2px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-2);
    text-align: center;
    line-height: 1.25;
  }
  .avm :global(.plabel.hi) {
    color: var(--accent);
    font-weight: 600;
  }
  .avm :global(.head) {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    flex: none;
  }
  .avm :global(.bar),
  .avm :global(.shootbar) {
    width: 70%;
    border-radius: 6px 6px 0 0;
  }
  .avm :global(.shootbar) {
    transition: height 1.1s cubic-bezier(0.3, 1.5, 0.5, 1), background-color 0.5s;
  }
  .avm :global(.line) {
    position: absolute;
    left: 0;
    right: 0;
    transition: bottom 0.8s var(--ease);
  }
  .avm :global(.med) {
    border-top: 2px dashed var(--info);
  }
  .avm :global(.mean) {
    border-top: 2px solid var(--accent);
  }
  .avm :global(.ghost) {
    border-top: 2px dotted var(--text-3);
    opacity: 0.8;
  }
  .avm :global(.pull) {
    position: absolute;
    /* In the gap between the 3rd and 4th people, so it never crosses a label */
    left: calc(8px + (100% - 16px - 100px) * 3 / 11 + 25px);
    width: 3px;
    background: var(--accent);
    border-radius: 2px;
    transition: height 0.9s var(--ease) 0.25s, bottom 0.8s var(--ease);
  }
  .avm :global(.pull span) {
    position: absolute;
    top: -9px;
    left: -7px;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-bottom: 12px solid var(--accent);
  }
  .avm-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-2);
  }
  .avm-key :global(.kk) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .avm-key :global(.kk b) {
    font-weight: 600;
  }
  .avm-key :global(.kk i) {
    flex: none;
    width: 22px;
    height: 0;
  }
  .avm-key :global(.mean b),
  .avm-key :global(.pull b) {
    color: var(--accent);
  }
  .avm-key :global(.mean i) {
    border-top: 2px solid var(--accent);
  }
  .avm-key :global(.med b) {
    color: var(--info);
  }
  .avm-key :global(.med i) {
    border-top: 2px dashed var(--info);
  }
  .avm-key :global(.pull) {
    flex-basis: 100%;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
  }
  .avm-key :global(.pull i) {
    width: 3px;
    height: 16px;
    background: var(--accent);
    border-radius: 2px;
    margin-inline: 9px 10px;
  }
  .avm-key :global(.ghost-k) {
    flex-basis: 100%;
    font-family: var(--font-sans);
    font-size: 14px;
  }
  .avm-key :global(.ghost-k i) {
    display: none;
  }
  .avm-key :global(.cut) {
    flex-basis: 100%;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-2);
  }
  .avm-key :global(.cut i) {
    width: 22px;
    border-top: 4px dashed #ffc2a0;
  }
  .avm-key :global(.cut b) {
    color: var(--accent);
  }
  .avm-key :global(em) {
    font-style: normal;
    color: var(--accent);
  }
  .press {
    background: var(--text);
    color: #1a1a1a;
    border-radius: 6px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 6px 6px 0 var(--sh);
  }
  .pk {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .pq {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }
  .pu {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }
  .okbox {
    border: 1px solid var(--ok);
    background: var(--ok-bg);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ----------------------------------------------------------- 4 correlation */
  .cor-ctl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .opts :global(.opt) {
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid var(--line-control);
    background: transparent;
    color: var(--text);
    font-size: 14px;
  }
  .opts :global(.opt.on) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .cor-ctl :global(.green) {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--ok);
    background: transparent;
    color: var(--ok);
    font-size: 14px;
    font-weight: 600;
  }
  .cor-ctl :global(.green.on) {
    background: var(--ok-bg);
  }
  .cor-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .cor-head figcaption {
    font-weight: 600;
  }
  .r {
    font-size: 14px;
  }
  .r :global(strong) {
    font-size: 22px;
  }
  .cor-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .cor-svg :global(polyline) {
    transition: all 0.6s;
  }
  .viral {
    position: relative;
    background: var(--text);
    color: #1a1a1a;
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }
  .v-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .v-top div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .v-name {
    font-weight: 600;
  }
  .v-handle,
  .v-meta {
    font-size: 13px;
    color: #5f5e5a;
  }
  .v-text {
    font-size: 18px;
    line-height: 1.35;
  }
  .viral :global(.stamp) {
    position: absolute;
    right: 14px;
    bottom: 16px;
    border: 3px solid #a32d2d;
    color: #a32d2d;
    border-radius: 6px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    background: #ece6d6e6;
    transform: rotate(-8deg);
    animation: stamp 0.5s var(--ease) both;
  }
  @keyframes stamp {
    0% { opacity: 0; transform: scale(2.2) rotate(-14deg); }
    70% { opacity: 1; transform: scale(0.95) rotate(-8deg); }
    100% { opacity: 1; transform: scale(1) rotate(-8deg); }
  }
  .diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .diagram :global(.hid) {
    border: 1px solid var(--ok);
    color: var(--ok);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
  }
  .diagram :global(.arrows) {
    font-family: var(--font-mono);
    color: var(--text-3);
  }
  .diagram :global(.pair) {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diagram :global(.pair span) {
    border: 1px solid;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
  }

  /* ----------------------------------------------------------- 5 misleading */
  .mk {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }
  .mkL {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .mkGoals,
  .mkTricks {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .goals {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .goals :global(.goal) {
    flex: 1 1 120px;
    min-height: 48px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--line-control);
    background: transparent;
    color: var(--text);
    font-size: 15px;
  }
  .goals :global(.goal.on) {
    border-color: var(--c);
    background: var(--c);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .tks {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tks :global(.tk) {
    min-height: 52px;
    text-align: left;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--line-control);
    background: transparent;
    color: var(--text);
    font-size: 15px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .tks :global(.tk .d) {
    font-size: 13px;
    color: var(--text-3);
  }
  .tks :global(.tk .pts) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .tks :global(.tk.on) {
    border-color: var(--accent);
    background: var(--warn-bg);
  }
  .tks :global(.tk.on .d) {
    color: var(--text-2);
  }
  .tks :global(.tk.on .pts) {
    color: var(--accent);
  }
  .mkR {
    flex: 2 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mkMeter {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-alt);
    padding: 16px 20px;
  }
  .meter {
    width: 180px;
    height: 104px;
    flex: none;
  }
  .meter :global(.arc) {
    transition: stroke-dashoffset 0.8s var(--ease), stroke 0.5s;
  }
  .verdict {
    flex: 1 1 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .verdict :global(.v) {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
  }
  .verdict :global(.vn) {
    font-size: 14px;
    color: var(--text-2);
  }
  .mkFigs {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .paper {
    flex: 3 1 340px;
    min-width: 0;
    margin: 0;
    background: var(--text);
    color: #1a1a1a;
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }
  .pk2 {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #5f5e5a;
  }
  .yh {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
  }
  .ychart {
    display: flex;
    gap: 8px;
  }
  .yaxis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 180px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #5f5e5a;
    text-align: right;
    min-width: 44px;
  }
  .ybars {
    flex: 1;
    min-width: 0;
    height: 180px;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    border-left: 1px solid #888780;
    border-bottom: 1px solid #888780;
    padding: 0 4px;
  }
  .ybars :global(.bar) {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 3px 3px 0 0;
  }
  .madeit {
    align-self: flex-start;
    border: 2px solid #a32d2d;
    color: #a32d2d;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    transform: rotate(-2deg);
  }
  .honestfig {
    flex: 2 1 240px;
    min-width: 0;
    margin: 0;
    background: var(--ok-bg);
    border: 1px solid var(--ok);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hf-h {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }
  .hbars {
    height: 150px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    border-left: 1px solid var(--line-control);
    border-bottom: 1px solid var(--line-control);
    padding: 0 4px;
  }
  .hbars span {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 3px 3px 0 0;
    background: var(--ok);
  }
  .hf-f {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-2);
  }
  .mkBtns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .b-acc,
  .b-ghost {
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .b-acc {
    border: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .b-ghost {
    border: 1px solid var(--line-control);
    background: transparent;
    color: var(--text);
  }
  .b-ghost:hover {
    color: var(--text);
    background: var(--bg-raised);
  }

  /* ----------------------------------------------------------- 6 surveys */
  .stick6 {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .spots {
    display: contents;
  }
  .grow {
    flex: 1 1 10px;
  }
  .stick6 :global(.spot),
  .stick6 :global(.reveal) {
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 2px solid var(--c, #e8d44d);
    background: transparent;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
  }
  .stick6 :global(.spot.on) {
    background: var(--c);
    color: var(--accent-ink);
  }
  .stick6 :global(.reveal) {
    color: #e8d44d;
  }
  .stick6 :global(.reveal.on) {
    background: #e8d44d;
    color: var(--accent-ink);
  }
  .field {
    width: 100%;
    height: auto;
    display: block;
  }
  .field :global(.zone) {
    transition: fill 0.5s;
  }
  .field :global(circle) {
    transition: fill 0.5s, opacity 0.5s, r 0.3s;
  }
  .field :global(.wander) {
    animation: wander 6s ease-in-out infinite;
  }
  @keyframes wander {
    25% { transform: translate(4px, -3px); }
    50% { transform: translate(-3px, 4px); }
    75% { transform: translate(3px, 3px); }
  }
  .report {
    background: #fff8e8;
