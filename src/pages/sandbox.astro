---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { url } from '../lib/url';
---
<Base title="Sandbox (coming soon)" description="Build your own model of Calgary from real datasets. Coming soon.">
  <section class="grid-bg soon">
    <div class="wrap inner">
      <p class="eyebrow">Sandbox · coming soon</p>
      <h1>Build your own model of Calgary.</h1>
      <p class="muted lead">Combine real datasets, set your own assumptions, and watch how each one moves the answer. It’s being refined before launch, so the numbers you play with are ones I can stand behind.</p>
      <ul class="list">
        <li><span class="mono n">01</span>Pick datasets from grouped libraries: housing, people, work, prices.</li>
        <li><span class="mono n">02</span>Link them with feedback loops and set every assumption with a slider.</li>
        <li><span class="mono n">03</span>See the range of outcomes, what matters most, and how the model scores against history.</li>
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={SITE.xUrl} rel="noopener" target="_blank">Follow on X for the launch</a>
        <a class="btn btn-ghost" href={url('learn/')}>Try the Learn lessons</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .soon { border-bottom: 1px solid var(--line); }
  .inner { padding-block: clamp(56px, 10vw, 104px); display: flex; flex-direction: column; gap: 20px; }
  h1 { font-size: clamp(36px, 7vw, 60px); max-width: 820px; }
  .lead { font-size: 18px; max-width: 680px; }
  .list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; max-width: 680px; }
  .list li { display: flex; gap: 14px; }
  .n { color: var(--accent); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
